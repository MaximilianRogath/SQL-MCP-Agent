# ============================================================
#  .env.example  —  Environment variable template
#  Copy to .env and fill in your values
#
#  Authentication: Azure resources use keyless auth
#  via Azure CLI. Run 'az login' before starting the agent.
# ============================================================

# --- Azure AI Foundry (Agent Framework) ---------------------
# Project endpoint from the Azure AI Foundry portal
AZURE_FOUNDRY_ENDPOINT=https://your-resource.services.ai.azure.com/api/projects/your-project

# Model deployment name
AZURE_FOUNDRY_MODEL=gpt-4o

# --- SQL MCP Server (Data API Builder) ----------------------
# URL of the locally running DAB MCP endpoint
# Start DAB with: dotnet dab start
MCP_SERVER_URL=http://localhost:5000/mcp

# --- Azure SQL Database (for DAB) ---------------------------
# Passwordless connection string using Active Directory Default
# Requires: az login before starting DAB
MSSQL_CONNECTION_STRING=Server=tcp:your-server.database.windows.net,1433;Initial Catalog=contoso-store-db;Authentication=Active Directory Default;TrustServerCertificate=False;Encrypt=True;
